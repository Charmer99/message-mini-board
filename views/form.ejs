<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
        <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Create a New Message</h1>
            <a class="button" href="/">Back</a>
        </header>

        <form class="form" method="POST" action="/new">
            <label class="label">
                Your name
                <input class="input" type="text" name="messageUser" placeholder="Your name" required>
            </label>

            <label class="label">
                Your message
                <input class="input" type="text" name="messageText" placeholder="Your message" required>
            </label>

            <div>
                <button class="button" type="submit">Send</button>
            </div>
        </form>
    </div>
</body>
</html>
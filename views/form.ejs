<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Create a New Message</h1>

<form method="POST" action="/new">

    <input
        type="text"
        name="messageUser"
        placeholder="Your name"
    >

    <br><br>

    <input
        type="text"
        name="messageText"
        placeholder="Your message"
    >

    <br><br>

    <button type="submit">
        Send
    </button>

</form>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Message</title>
	<link rel="stylesheet" href="/styles.css">
</head>
<body>
	<div class="container">
		<h1>Message Details</h1>

		<div class="message-detail">
			<h2>User</h2>
			<p><%= message.user %></p>

			<h2>Message</h2>
			<p><%= message.text %></p>

			<h2>Date</h2>
			<p><%= message.added %></p>
		</div>

		<a class="button" href="/">Back</a>
	</div>
</body>
</html>